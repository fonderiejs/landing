{
	"cleanUrls": true,
	"trailingSlash": false,
	"redirects": [
		{ "source": "/platform", "destination": "/products", "permanent": true },
		{ "source": "/blog", "destination": "/", "permanent": true },
		{ "source": "/blog/:path*", "destination": "/", "permanent": true }
	],
	"headers": [
		{
			"source": "/assets/fonts/(.*)",
			"headers": [
				{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
			]
		}
	]
}
